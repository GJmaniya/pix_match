# Copy to .env (never commit .env) and fill in real values.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/oauth2callback

# --- production (live site) ---
# APP_ENV=production        # enforces SECRET_KEY, secure cookies, HTTPS-only OAuth
# TRUST_PROXY=1             # when behind Render/Railway/Heroku/Nginx
# GOOGLE_REDIRECT_URI=https://your-domain/oauth2callback

# --- local development only ---
# FLASK_DEBUG=1             # never set on a public server
# DEV_OTP_ECHO=1            # shows the OTP in the response when email isn't configured
# MAX_UPLOAD_MB=200
# ALLOW_MISSING_ORIGIN=1     # only for curl/automated tests: allow POSTs that send no Origin header
